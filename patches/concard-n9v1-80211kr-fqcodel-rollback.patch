diff --git a/trunk/user/rc/rc.c b/trunk/user/rc/rc.c
index f7dea7508..9a0e9e73d 100644
--- a/trunk/user/rc/rc.c
+++ b/trunk/user/rc/rc.c
@@ -617,6 +617,21 @@ flash_firmware(void)
 	sync();
 	sleep(1);
 
+	/* CONCARD_STOCK_ROLLBACK_CLEAN_CFG: erase Config NVRAM when rolling back to Stock CSB334A */
+	{
+		FILE *fp_fw = fopen(FW_IMG_NAME, "rb");
+		if (fp_fw) {
+			char fw_hdr[64] = {0};
+			if (fread(fw_hdr, 1, sizeof(fw_hdr), fp_fw) == sizeof(fw_hdr) &&
+			    strncmp(fw_hdr + 32, "CSB334A-", 8) == 0) {
+				fclose(fp_fw);
+				fp_fw = NULL;
+				eval("/tmp/mtd_write", "erase", "Config");
+			}
+			if (fp_fw)
+				fclose(fp_fw);
+		}
+	}
 	if (eval("/tmp/mtd_write", "-r", "write", FW_IMG_NAME, FW_MTD_NAME) != 0) {
 		start_watchdog();
 	}
