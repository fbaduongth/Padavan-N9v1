diff --git a/trunk/proprietary/rt_wifi/rtpci/3.0.X.X/mt76x2/common/ft.c b/trunk/proprietary/rt_wifi/rtpci/3.0.X.X/mt76x2/common/ft.c
index aad1c3d8d..7022350d0 100644
--- a/trunk/proprietary/rt_wifi/rtpci/3.0.X.X/mt76x2/common/ft.c
+++ b/trunk/proprietary/rt_wifi/rtpci/3.0.X.X/mt76x2/common/ft.c
@@ -1620,10 +1620,59 @@ UINT16	FT_AuthReqRsnValidation(
 		if ((pR1hkEntry == NULL) ||
 			(RTMPEqualMemory(pEntry->FT_PMK_R1_NAME, pR1hkEntry->PmkR1Name, LEN_PMK_NAME) == FALSE))
 		{
+			/* CONCARD_FT_PSK_LOCAL: Controller-less IEEE 802.11r FT-PSK key derivation
+			 * (equivalent to hostapd ft_psk_generate_local=1). When all APs share the
+			 * same SSID, PSK, MDID, and R0KH-ID, PMK-R0 and PMK-R1 are deterministic. */
+			MULTISSID_STRUCT *pMbss = &pAd->ApCfg.MBSSID[pEntry->apidx];
+			if ((pMbss->wdev.AuthMode == Ndis802_11AuthModeWPA2PSK) ||
+				(pMbss->wdev.AuthMode == Ndis802_11AuthModeWPA1PSKWPA2PSK))
+			{
+				UINT8 localPmkR0[LEN_PMK];
+				UINT8 localPmkR0Name[LEN_PMK_NAME];
+				UINT8 localPmkR1[LEN_PMK];
+				UINT8 localPmkR1Name[LEN_PMK_NAME];
+				UINT8 localCount = 0;
+				PUINT8 localAkm = WPA_ExtractSuiteFromRSNIE(pFtInfo_in->RSN_IE, pFtInfo_in->RSNIE_Len, AKM_SUITE, &localCount);
+				PUINT8 localCipher = WPA_ExtractSuiteFromRSNIE(pFtInfo_in->RSN_IE, pFtInfo_in->RSNIE_Len, PAIRWISE_SUITE, &localCount);
+				UCHAR ftPskOUI[4] = {0x00, 0x0F, 0xAC, 0x04};
+
+				if (localAkm != NULL && localCipher != NULL &&
+					RTMPEqualMemory(localAkm, ftPskOUI, 4))
+				{
+					FT_DerivePMKR0(pMbss->PMK, LEN_PMK,
+						(PUINT8)pMbss->Ssid, pMbss->SsidLen,
+						pFtCfg->FtMdId,
+						pFtCfg->FtR0khId, pFtCfg->FtR0khIdLen,
+						pEntry->Addr,
+						localPmkR0, localPmkR0Name);
+
+					if (RTMPEqualMemory(pPmkR0Name, localPmkR0Name, LEN_PMK_NAME) == TRUE)
+					{
+						UINT32 keyLife = (pMbss->PMKCachePeriod > 0) ? (pMbss->PMKCachePeriod / OS_HZ) : 43200;
+						FT_DerivePMKR1(localPmkR0, localPmkR0Name,
+							pMbss->wdev.bssid, pEntry->Addr,
+							localPmkR1, localPmkR1Name);
+
+						if (pR1hkEntry != NULL)
+							FT_R1khEntryDelete(pAd, pR1hkEntry);
+
+						NdisMoveMemory(pEntry->FT_PMK_R0, localPmkR0, LEN_PMK);
+						NdisMoveMemory(pEntry->FT_PMK_R0_NAME, localPmkR0Name, LEN_PMK_NAME);
+						FT_R1khEntryInsert(pAd,
+							localPmkR0Name, localPmkR1Name, localPmkR1,
+							localCipher, localAkm,
+							keyLife, 20,
+							pFtCfg->FtR0khId, pFtCfg->FtR0khIdLen,
+							pEntry->Addr);
+						pR1hkEntry = FT_R1khEntryTabLookup(pAd, pEntry->FT_PMK_R1_NAME);
+					}
+				}
+			}
 
-			/*	If the requested R0KH is not reachable, the AP shall respond 
-				to the Authentication Request with status code 28 ("R0KH unreachable"). */
-			{											
+			/*	If the requested R0KH is still not reachable, respond with status code 28. */
+			if ((pR1hkEntry == NULL) ||
+				(RTMPEqualMemory(pEntry->FT_PMK_R1_NAME, pR1hkEntry->PmkR1Name, LEN_PMK_NAME) == FALSE))
+			{
 				return FT_STATUS_CODE_R0KH_UNREACHABLE;
 			}
 		}
@@ -3017,8 +3066,10 @@ void FT_rtmp_read_parameters_from_file(
 		{
 			if (strlen(tmpbuf) <= FT_ROKH_ID_LEN)
 			{
+				NdisZeroMemory(pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khId, sizeof(pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khId));
 				NdisMoveMemory(pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khId, tmpbuf, strlen(tmpbuf));
 				pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khId[strlen(tmpbuf)] = '\0';
+				pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khIdLen = strlen(tmpbuf);
 				DBGPRINT(RT_DEBUG_TRACE, ("%s::FtR0khId(%d)=%s\n", __FUNCTION__, Loop,
 											pAd->ApCfg.MBSSID[Loop].FtCfg.FtR0khId));
 			}
